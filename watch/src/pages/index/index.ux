<template>
  <div class="page">
    <text class="brand">WristBrowser</text>
    <text class="status">{{status}}</text>
    <div class="toolbar">
      <text class="address" @click="showKeyboard">{{query || 'Поиск или адрес сайта'}}</text>
      <input type="button" class="go" value="GO" @click="submitSearch" />
    </div>
    <div class="controls">
      <input type="button" class="control" value="BACK" @click="sendCommand('back')" />
      <input type="button" class="control" value="NEXT" @click="sendCommand('forward')" />
      <input type="button" class="control" value="↻" @click="sendCommand('reload')" />
    </div>
    <text class="heading">{{pageTitle}}</text>
    <text class="url">{{pageUrl}}</text>
    <div if="{{!keyboardVisible}}" class="readerArea">
      <scroll class="reader" scroll-y="true" scroll-x="false">
        <text class="body">{{pageText}}</text>
        <div class="linkList">
          <text class="link" for="{{item in pageLinks}}" @click="openLink(item.url)">{{item.title}}</text>
        </div>
      </scroll>
    </div>
    <div if="{{keyboardVisible}}" class="keyboard">
      <text class="typed">{{query}}_</text>
      <div class="keyRow">
        <text class="key" for="{{item in row1}}" @click="appendKey(item)">{{item}}</text>
      </div>
      <div class="keyRow">
        <text class="key" for="{{item in row2}}" @click="appendKey(item)">{{item}}</text>
      </div>
      <div class="keyRow">
        <text class="key" for="{{item in row3}}" @click="appendKey(item)">{{item}}</text>
        <text class="key special" @click="deleteKey">⌫</text>
      </div>
      <div class="keyRow">
        <text class="key special" @click="appendKey('.')">.</text>
        <text class="key spaceKey" @click="appendKey(' ')">SPACE</text>
        <text class="key special" @click="appendKey('/')">/</text>
        <text class="key goKey" @click="submitSearch">GO</text>
      </div>
      <text class="cancel" @click="hideKeyboard">CLOSE</text>
    </div>
    <text class="hint">Листай текст пальцем вверх и вниз прямо на часах</text>
  </div>
</template>

<script>
import interconnect from '@system.interconnect'

let connection = null

export default {
  private: {
    status: 'Подключаемся к телефону…',
    pageTitle: 'Открой сайт в приложении на телефоне',
    pageUrl: '',
    pageText: 'Проверка кириллицы: Привет, мир! Ёё Жж Яя. Числа: 12345. Знаки: № ₽ © → • — …',
    pageLinks: [],
    query: '',
    keyboardVisible: false,
    transferId: '',
    expectedChunks: 0,
    chunks: [],
    received: 0,
    row1: ['Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P'],
    row2: ['A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L'],
    row3: ['Z', 'X', 'C', 'V', 'B', 'N', 'M']
  },

  onInit() {
    this.bindConnection()
  },

  bindConnection() {
    connection = interconnect.instance()
    connection.onopen = () => { this.status = 'Телефон подключён' }
    connection.onclose = () => { this.status = 'Связь с телефоном прервана' }
    connection.onerror = (event) => { this.status = 'Ошибка связи: ' + String(event && event.code || '') }
    connection.onmessage = (event) => {
      const raw = event && event.data !== undefined ? event.data : ''
      this.handleMessage(raw)
    }
    connection.getReadyState({
      success: (result) => {
        this.status = result && result.status === 1 ? 'Телефон подключён' : 'Ожидаем приложение на телефоне…'
      },
      fail: () => { this.status = 'Ожидаем соединение с телефоном…' }
    })
  },

  handleMessage(raw) {
    let message
    try {
      message = typeof raw === 'string' ? JSON.parse(raw) : raw
    } catch (error) {
      this.status = 'Не удалось прочитать сообщение'
      return
    }
    if (!message || !message.type) return

    if (message.type === 'page_start') {
      this.transferId = message.id || ''
      this.pageTitle = message.title || 'Страница'
      this.pageUrl = message.url || ''
      this.expectedChunks = Number(message.chunks || 0)
      this.chunks = []
      this.received = 0
      this.pageText = ''
      this.pageLinks = []
      this.status = 'Получаем страницу…'
    } else if (message.type === 'page_chunk') {
      if (message.id !== this.transferId) return
      this.chunks[Number(message.index)] = message.text || ''
      this.received++
      this.status = 'Загрузка страницы: ' + this.received + '/' + this.expectedChunks
    } else if (message.type === 'page_end') {
      if (message.id !== this.transferId) return
      const content = this.chunks.join('')
      const marker = '\n\n__WRIST_LINKS__\n'
      const markerIndex = content.indexOf(marker)
      if (markerIndex >= 0) {
        this.pageText = content.slice(0, markerIndex)
        try {
          this.pageLinks = JSON.parse(content.slice(markerIndex + marker.length)) || []
        } catch (error) {
          this.pageLinks = []
        }
      } else {
        this.pageText = content
        this.pageLinks = []
      }
      this.status = 'Страница загружена'
      this.sendCommand('page_ack', {id: this.transferId, ok: true})
    } else if (message.type === 'transfer_error') {
      this.status = message.message || 'Ошибка передачи страницы'
    }
  },

  sendCommand(type, extra) {
    if (!connection) connection = interconnect.instance()
    const data = Object.assign({type: type}, extra || {})
    connection.send({
      data: data,
      success: () => {},
      fail: (error, code) => { this.status = 'Не удалось отправить команду: ' + String(code || '') }
    })
  },

  openLink(url) {
    const target = String(url || '')
    if (!target || target.indexOf('https://') !== 0) {
      this.status = 'Эта ссылка не поддерживается'
      return
    }
    this.sendCommand('open_link', {url: target})
    this.status = 'Открываем ссылку…'
  },
  showKeyboard() { this.keyboardVisible = true },
  hideKeyboard() { this.keyboardVisible = false },
  appendKey(key) { this.query = String(this.query || '') + String(key || '') },
  deleteKey() { this.query = String(this.query || '').slice(0, -1) },
  submitSearch() {
    const value = String(this.query || '').trim()
    if (!value) return
    this.keyboardVisible = false
    this.sendCommand('search', {query: value})
    this.status = 'Ищем: ' + value
  }
}
</script>

<style>
.page {
  width: 466px;
  height: 466px;
  flex-direction: column;
  align-items: center;
  padding: 14px 18px 10px;
  box-sizing: border-box;
  background-color: #101820;
}
.brand { color: #8ed6c5; font-size: 20px; font-weight: bold; margin-bottom: 3px; }
.status { width: 420px; color: #8ed6c5; font-size: 13px; text-align: center; margin-bottom: 6px; }
.toolbar { width: 420px; height: 42px; flex-direction: row; align-items: center; margin-bottom: 5px; }
.address { width: 345px; height: 40px; color: #ffffff; background-color: #263440; font-size: 15px; padding: 10px; }
.go { width: 68px; height: 40px; color: #101820; background-color: #8ed6c5; font-size: 14px; margin-left: 6px; }
.controls { width: 420px; height: 34px; flex-direction: row; justify-content: space-between; margin-bottom: 5px; }
.control { width: 130px; height: 32px; color: #101820; background-color: #8ed6c5; font-size: 13px; }
.heading { width: 420px; color: #ffffff; font-size: 18px; font-weight: bold; max-lines: 2; margin-bottom: 2px; }
.url { width: 420px; color: #91a1ad; font-size: 10px; max-lines: 1; margin-bottom: 5px; }
.readerArea { width: 420px; height: 285px; }
.reader { width: 420px; height: 285px; }
.body { width: 410px; color: #e2e8ed; font-size: 17px; }
.linkList { width: 410px; flex-direction: column; margin-top: 8px; }
.link { width: 405px; color: #8ed6c5; font-size: 15px; padding: 8px 4px; border-bottom: 1px solid #344653; }
.hint { width: 420px; color: #8797a3; font-size: 10px; text-align: center; margin-top: 5px; }
.keyboard { width: 430px; flex-direction: column; align-items: center; }
.typed { width: 410px; height: 38px; color: #ffffff; background-color: #263440; font-size: 16px; text-align: center; padding: 8px; margin-bottom: 5px; }
.keyRow { width: 430px; height: 43px; flex-direction: row; justify-content: center; align-items: center; margin-bottom: 4px; }
.key { min-width: 32px; height: 38px; color: #ffffff; background-color: #344653; font-size: 15px; text-align: center; padding: 10px 3px; margin-left: 2px; margin-right: 2px; }
.special { background-color: #526675; }
.spaceKey { width: 105px; font-size: 11px; }
.goKey { width: 48px; color: #101820; background-color: #8ed6c5; font-size: 13px; }
.cancel { color: #9aa7b2; font-size: 11px; padding: 4px; }
</style>
