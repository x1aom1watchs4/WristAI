<template>
  <div class="page">
    <text class="brand">WristBrowser</text>
    <text class="status">{{status}}</text>
    <text class="networkStatus">{{networkStatus}}</text>

    <div if="{{!keyboardVisible}}" class="browser">
      <text class="searchBox" @click="showKeyboard">{{query || 'Нажми здесь для поиска'}}</text>
      <div class="controls">
        <input type="button" class="searchButton" value="GO" @click="openQuery" />
        <input type="button" class="smallButton" value="BACK" @click="goBack" />
        <input type="button" class="smallButton" value="NEXT" @click="goForward" />
      </div>
      <input type="button" class="testButton" value="TEST NETWORK" @click="runDiagnostics" />
      <text class="heading">{{pageTitle}}</text>
      <scroll class="reader">
        <text class="body">{{pageText}}</text>
      </scroll>
    </div>

    <div if="{{keyboardVisible}}" class="keyboard">
      <text class="typed" @click="hideKeyboard">{{query}}_</text>
      <div class="keyRow">
        <text class="key" for="{{item in row1}}" @click="appendKey(item)">{{item}}</text>
      </div>
      <div class="keyRow">
        <text class="key" for="{{item in row2}}" @click="appendKey(item)">{{item}}</text>
      </div>
      <div class="keyRow">
        <text class="key" for="{{item in row3}}" @click="appendKey(item)">{{item}}</text>
        <text class="key special" @click="deleteKey">⌫</text>
      </div>
      <div class="keyRow bottomRow">
        <text class="key special" @click="appendKey('.')">.</text>
        <text class="key spaceKey" @click="appendKey(' ')">SPACE</text>
        <text class="key special" @click="appendKey('/')">/</text>
        <text class="key goKey" @click="submitKeyboard">GO</text>
      </div>
      <text class="cancel" @click="hideKeyboard">CLOSE KEYBOARD</text>
    </div>
  </div>
</template>

<script>
import fetch from '@system.fetch'
import network from '@system.network'
import interconnect from '@system.interconnect'

export default {
  private: {
    status: 'Ready — direct watch connection',
    networkStatus: 'Network not tested yet',
    pageTitle: 'Search the web',
    pageText: 'Tap the search field to open the on-screen keyboard.',
    query: '',
    currentUrl: '',
    history: [],
    historyIndex: -1,
    requestNumber: 0,
    keyboardVisible: false,
    row1: ['Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P'],
    row2: ['A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L'],
    row3: ['Z', 'X', 'C', 'V', 'B', 'N', 'M']
  },
  onReady() {
    this.runDiagnostics()
  },
  runDiagnostics() {
    this.networkStatus = 'Checking network and phone bridge...'
    const results = []
    const update = () => { this.networkStatus = results.join(' | ') }
    try {
      if (!network || typeof network.getType !== 'function') {
        results.push('Network API unavailable')
        update()
      } else {
        network.getType({
          success: (data) => { results.push('Network: ' + String(data && data.type || 'unknown')); update() },
          fail: (data, code) => { results.push('Network API error ' + String(code || '') + ': ' + String(data || '')); update() }
        })
      }
    } catch (error) {
      results.push('Network API exception: ' + String(error))
      update()
    }
    try {
      if (!interconnect || typeof interconnect.instance !== 'function') {
        results.push('Phone bridge API unavailable: interconnect.instance is not a function')
        update()
      } else {
        const connect = interconnect.instance()
        if (!connect) {
          results.push('Phone bridge unavailable: no connection instance')
          update()
        } else if (typeof connect.diagnosis === 'function') {
          connect.diagnosis({
            timeout: 8000,
            success: (data) => {
              const labels = {0: 'connected', 204: 'timeout', 1001: 'phone app missing', 1000: 'other error'}
              results.push('Phone bridge diagnosis: ' + String(labels[data && data.status] || (data && data.status) || 'unknown'))
              update()
            },
            fail: (data, code) => { results.push('Phone bridge diagnosis error ' + String(code || '') + ': ' + String(data || '')); update() }
          })
        } else if (typeof connect.getReadyState === 'function') {
          connect.getReadyState({
            success: (data) => { results.push('Phone bridge readyState: ' + String(data && data.status)); update() },
            fail: (data, code) => { results.push('Phone bridge state error ' + String(code || '') + ': ' + String(data || '')); update() }
          })
        } else {
          results.push('Phone bridge instance found, but diagnosis/getReadyState are unavailable')
          update()
        }
      }
    } catch (error) {
      results.push('Phone bridge exception: ' + String(error))
      update()
    }
    try {
      if (!fetch || typeof fetch.fetch !== 'function') {
        results.push('Fetch API unavailable')
        update()
      } else {
        fetch.fetch({
          url: 'https://example.com',
          method: 'GET',
          responseType: 'text',
          success: (response) => { results.push('HTTPS test: HTTP ' + String(response && response.code || 'unknown')); update() },
          fail: (data, code) => { results.push('HTTPS test failed: ' + String(code || '') + ' ' + String(data || '')); update() }
        })
      }
    } catch (error) {
      results.push('HTTPS test exception: ' + String(error))
      update()
    }
  },
  showKeyboard() {
    this.keyboardVisible = true
  },
  hideKeyboard() {
    this.keyboardVisible = false
  },
  appendKey(key) {
    this.query = String(this.query || '') + String(key || '')
  },
  deleteKey() {
    this.query = String(this.query || '').slice(0, -1)
  },
  submitKeyboard() {
    this.keyboardVisible = false
    this.openQuery()
  },
  normalizeUrl(value) {
    const input = String(value || '').trim()
    if (!input) return ''
    if (/^https?:\/\//i.test(input)) return input
    if (input.indexOf(' ') >= 0 || input.indexOf('.') < 0) {
      return 'https://www.google.com/search?q=' + encodeURIComponent(input)
    }
    return 'https://' + input
  },
  openQuery() {
    const url = this.normalizeUrl(this.query)
    if (!url) {
      this.status = 'Enter a search or website'
      this.keyboardVisible = true
      return
    }
    this.keyboardVisible = false
    this.history = this.history.slice(0, this.historyIndex + 1)
    this.history.push(url)
    this.historyIndex = this.history.length - 1
    this.loadUrl(url)
  },
  loadUrl(url) {
    this.requestNumber++
    const requestId = this.requestNumber
    this.currentUrl = url
    this.status = 'Loading directly on watch...'
    this.pageTitle = url
    this.pageText = 'Downloading page content...'
    fetch.fetch({
      url: url,
      method: 'GET',
      responseType: 'text',
      header: {
        'Accept': 'text/html,application/xhtml+xml,text/plain;q=0.9,*/*;q=0.8',
        'Accept-Language': 'en-US,en;q=0.8'
      },
      success: (response) => {
        if (requestId !== this.requestNumber) return
        if (!response || response.code < 200 || response.code >= 400) {
          this.status = 'HTTP error: ' + (response ? response.code : 'no response')
          this.pageText = 'The website did not return a readable page.'
          return
        }
        const html = typeof response.data === 'string' ? response.data : String(response.data || '')
        this.showHtml(html, url)
        this.status = 'Loaded directly on watch · HTTP ' + response.code
      },
      fail: (error, code) => {
        if (requestId !== this.requestNumber) return
        this.status = 'Network error ' + String(code || '')
        this.pageText = 'Could not load this page. Check the watch internet connection and try again. ' + String(error || '')
      }
    })
  },
  decodeHtml(text) {
    return String(text || '')
      .replace(/&nbsp;|&#160;/gi, ' ')
      .replace(/&amp;/gi, '&')
      .replace(/&lt;/gi, '<')
      .replace(/&gt;/gi, '>')
      .replace(/&quot;/gi, '"')
      .replace(/&#39;|&apos;/gi, "'")
      .replace(/&#(\d+);/g, (match, number) => String.fromCharCode(Number(number)))
      .replace(/&#x([0-9a-f]+);/gi, (match, number) => String.fromCharCode(parseInt(number, 16)))
  },
  showHtml(html, url) {
    let title = ''
    const titleMatch = html.match(/<title[^>]*>([\s\S]*?)<\/title>/i)
    if (titleMatch) title = this.decodeHtml(titleMatch[1].replace(/<[^>]*>/g, ' ')).trim()
    let content = html
      .replace(/<!--[\s\S]*?-->/g, ' ')
      .replace(/<(script|style|noscript|svg|iframe|nav|footer)[^>]*>[\s\S]*?<\/\1>/gi, ' ')
      .replace(/<(br|\/p|\/div|\/li|\/h[1-6]|\/section|\/article|\/tr|\/blockquote)[^>]*>/gi, '\n')
      .replace(/<[^>]+>/g, ' ')
    content = this.decodeHtml(content)
      .replace(/[\t\r ]+/g, ' ')
      .replace(/ *\n */g, '\n')
      .replace(/\n{3,}/g, '\n\n')
      .trim()
    if (!content) content = 'This page contains no readable text, or the site requires JavaScript.'
    this.pageTitle = title || url
    this.pageText = content.slice(0, 24000)
  },
  goBack() {
    if (this.historyIndex <= 0) {
      this.status = 'No previous page'
      return
    }
    this.historyIndex--
    this.loadUrl(this.history[this.historyIndex])
  },
  goForward() {
    if (this.historyIndex >= this.history.length - 1) {
      this.status = 'No next page'
      return
    }
    this.historyIndex++
    this.loadUrl(this.history[this.historyIndex])
  },
  reloadPage() {
    if (this.currentUrl) this.loadUrl(this.currentUrl)
    else this.openQuery()
  }
}
</script>

<style>
.page {
  width: 466px;
  height: 466px;
  flex-direction: column;
  align-items: center;
  padding: 18px 0px 12px;
  box-sizing: border-box;
  background-color: #101820;
  font-family: sans-serif;
}
.brand { color: #8ed6c5; font-size: 18px; font-weight: bold; margin-bottom: 3px; }
.status { width: 300px; color: #9aa7b2; font-size: 11px; margin-bottom: 4px; text-align: center; }
.networkStatus { width: 300px; color: #8ed6c5; font-size: 10px; margin-bottom: 6px; text-align: center; }
.testButton { width: 300px; height: 30px; color: #101820; background-color: #526675; font-size: 11px; margin-bottom: 6px; }
.browser { width: 300px; flex-direction: column; align-items: center; }
.searchBox { width: 300px; height: 42px; padding: 10px 8px; color: #ffffff; background-color: #263440; font-size: 14px; text-align: center; margin-bottom: 7px; }
.controls { width: 300px; height: 36px; flex-direction: row; justify-content: space-between; margin-bottom: 6px; }
.searchButton { width: 66px; height: 34px; color: #101820; background-color: #8ed6c5; font-size: 12px; }
.smallButton { width: 70px; height: 34px; color: #101820; background-color: #8ed6c5; font-size: 11px; }
.heading { width: 300px; color: #ffffff; font-size: 13px; font-weight: bold; margin-bottom: 5px; text-align: center; }
.reader { width: 300px; height: 300px; }
.body { color: #e2e8ed; font-size: 15px; line-height: 1.35; }
.keyboard { width: 450px; flex-direction: column; align-items: center; margin-top: 8px; }
.typed { width: 420px; min-height: 44px; color: #ffffff; background-color: #263440; font-size: 17px; text-align: center; padding: 10px 6px; margin-bottom: 12px; }
.keyRow { width: 440px; height: 52px; flex-direction: row; justify-content: center; align-items: center; margin-bottom: 7px; }
.key { min-width: 34px; height: 46px; color: #ffffff; background-color: #344653; font-size: 17px; text-align: center; padding: 12px 4px; margin-left: 2px; margin-right: 2px; border-radius: 6px; }
.special { background-color: #526675; }
.spaceKey { width: 115px; font-size: 12px; }
.goKey { width: 54px; color: #101820; background-color: #8ed6c5; font-size: 14px; }
.bottomRow .key { min-width: 38px; }
.cancel { color: #9aa7b2; font-size: 12px; padding: 8px; }
</style>
