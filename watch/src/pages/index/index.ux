<template>
  <div class="page">
    <text class="brand">WristAI</text>
    <text class="status">{{status}}</text>
    <scroll class="chat" if="{{!keyboardVisible}}" scroll-y="true" scroll-x="false">
      <text class="conversation">{{conversation}}</text>
    </scroll>
    <div class="composer" @click="showKeyboard"><text class="prompt">{{query || 'Нажми, чтобы задать вопрос ИИ'}}</text></div>
    <div class="actions">
      <text class="send" @click="submitPrompt">ОТПРАВИТЬ</text>
      <text class="clear" @click="clearInput">ОЧИСТИТЬ</text>
    </div>
    <div class="keyboard" if="{{keyboardVisible}}">\n      <div class="typed"><div class="typedGlyph" for="{{item in queryGlyphs}}"><image if="{{item.image}}" class="typedImage" src="{{item.image}}" /><text if="{{!item.image}}" class="typedPlain">{{item.char}}</text></div><text class="typedCursor">_</text></div>
      <div class="keyRow" if="{{keyboardLanguage === 'ru'}}"><div class="key imageKey" @click="appendKey('Й')"><image class="glyph" src="/common/keyboard/u0419.png" /></div><div class="key imageKey" @click="appendKey('Ц')"><image class="glyph" src="/common/keyboard/u0426.png" /></div><div class="key imageKey" @click="appendKey('У')"><image class="glyph" src="/common/keyboard/u0423.png" /></div><div class="key imageKey" @click="appendKey('К')"><image class="glyph" src="/common/keyboard/u041A.png" /></div><div class="key imageKey" @click="appendKey('Е')"><image class="glyph" src="/common/keyboard/u0415.png" /></div><div class="key imageKey" @click="appendKey('Н')"><image class="glyph" src="/common/keyboard/u041D.png" /></div><div class="key imageKey" @click="appendKey('Г')"><image class="glyph" src="/common/keyboard/u0413.png" /></div><div class="key imageKey" @click="appendKey('Ш')"><image class="glyph" src="/common/keyboard/u0428.png" /></div><div class="key imageKey" @click="appendKey('Щ')"><image class="glyph" src="/common/keyboard/u0429.png" /></div><div class="key imageKey" @click="appendKey('З')"><image class="glyph" src="/common/keyboard/u0417.png" /></div><div class="key imageKey" @click="appendKey('Х')"><image class="glyph" src="/common/keyboard/u0425.png" /></div></div>
      <div class="keyRow" if="{{keyboardLanguage === 'ru'}}"><div class="key imageKey" @click="appendKey('Ф')"><image class="glyph" src="/common/keyboard/u0424.png" /></div><div class="key imageKey" @click="appendKey('Ы')"><image class="glyph" src="/common/keyboard/u042B.png" /></div><div class="key imageKey" @click="appendKey('В')"><image class="glyph" src="/common/keyboard/u0412.png" /></div><div class="key imageKey" @click="appendKey('А')"><image class="glyph" src="/common/keyboard/u0410.png" /></div><div class="key imageKey" @click="appendKey('П')"><image class="glyph" src="/common/keyboard/u041F.png" /></div><div class="key imageKey" @click="appendKey('Р')"><image class="glyph" src="/common/keyboard/u0420.png" /></div><div class="key imageKey" @click="appendKey('О')"><image class="glyph" src="/common/keyboard/u041E.png" /></div><div class="key imageKey" @click="appendKey('Л')"><image class="glyph" src="/common/keyboard/u041B.png" /></div><div class="key imageKey" @click="appendKey('Д')"><image class="glyph" src="/common/keyboard/u0414.png" /></div><div class="key imageKey" @click="appendKey('Ж')"><image class="glyph" src="/common/keyboard/u0416.png" /></div><div class="key imageKey" @click="appendKey('Э')"><image class="glyph" src="/common/keyboard/u042D.png" /></div></div>
      <div class="keyRow" if="{{keyboardLanguage === 'ru'}}"><div class="key imageKey" @click="appendKey('Я')"><image class="glyph" src="/common/keyboard/u042F.png" /></div><div class="key imageKey" @click="appendKey('Ч')"><image class="glyph" src="/common/keyboard/u0427.png" /></div><div class="key imageKey" @click="appendKey('С')"><image class="glyph" src="/common/keyboard/u0421.png" /></div><div class="key imageKey" @click="appendKey('М')"><image class="glyph" src="/common/keyboard/u041C.png" /></div><div class="key imageKey" @click="appendKey('И')"><image class="glyph" src="/common/keyboard/u0418.png" /></div><div class="key imageKey" @click="appendKey('Т')"><image class="glyph" src="/common/keyboard/u0422.png" /></div><div class="key imageKey" @click="appendKey('Ь')"><image class="glyph" src="/common/keyboard/u042C.png" /></div><div class="key imageKey" @click="appendKey('Б')"><image class="glyph" src="/common/keyboard/u0411.png" /></div><div class="key imageKey" @click="appendKey('Ю')"><image class="glyph" src="/common/keyboard/u042E.png" /></div><div class="key imageKey" @click="appendKey('Ё')"><image class="glyph" src="/common/keyboard/u0401.png" /></div><div class="key imageKey" @click="appendKey('Ъ')"><image class="glyph" src="/common/keyboard/u042A.png" /></div><text class="key special" @click="deleteKey">⌫</text></div>
      <div class="keyRow" if="{{keyboardLanguage === 'en'}}"><text class="key" for="{{item in row1}}" @click="appendKey(item)">{{item}}</text></div>
      <div class="keyRow" if="{{keyboardLanguage === 'en'}}"><text class="key" for="{{item in row2}}" @click="appendKey(item)">{{item}}</text></div>
      <div class="keyRow" if="{{keyboardLanguage === 'en'}}"><text class="key" for="{{item in row3}}" @click="appendKey(item)">{{item}}</text><text class="key special" @click="deleteKey">⌫</text></div>
      <div class="keyRow">
        <text class="key special" @click="appendKey('.')">.</text>
        <text class="key spaceKey" @click="appendKey(' ')">ПРОБЕЛ</text>
        <text class="key special" @click="appendKey('?')">?</text>
        <text class="key special" @click="toggleKeyboardLanguage">{{keyboardLanguage === 'ru' ? 'EN' : 'РУС'}}</text>
      </div>
      <div class="keyRow"><text class="key special" @click="hideKeyboard">ГОТОВО</text><text class="key special" @click="submitPrompt">ОТПРАВИТЬ</text></div>
    </div>
  </div>
</template>
<script>
import interconnect from '@system.interconnect'
let connection = null
export default {
  private: {
    status: 'Подключаемся к телефону…',
    conversation: 'WristAI готов. Введи вопрос — телефон отправит его в Gemini и вернёт ответ сюда.',
    query: '', queryGlyphs: [], keyboardVisible: true, keyboardLanguage: 'ru',
    transferId: '', expectedChunks: 0, chunks: [], received: 0,
    ruRow1: ['Й','Ц','У','К','Е','Н','Г','Ш','Щ','З','Х'],
    ruRow2: ['Ф','Ы','В','А','П','Р','О','Л','Д','Ж','Э'],
    ruRow3: ['Я','Ч','С','М','И','Т','Ь','Б','Ю','Ё','Ъ'],
    row1: ['Q','W','E','R','T','Y','U','I','O','P'],
    row2: ['A','S','D','F','G','H','J','K','L'],
    row3: ['Z','X','C','V','B','N','M']
  },
  onInit() { this.updateQueryGlyphs(); this.bindConnection() },
  bindConnection() {
    connection = interconnect.instance()
    connection.onopen = () => { this.status = 'Телефон подключён' }
    connection.onclose = () => { this.status = 'Связь с телефоном прервана' }
    connection.onerror = (event) => { this.status = 'Ошибка связи: ' + String(event && event.code || '') }
    connection.onmessage = (event) => { this.handleMessage(event && event.data !== undefined ? event.data : '') }
    connection.getReadyState({
      success: (result) => { this.status = result && result.status === 1 ? 'Телефон подключён' : 'Ожидаем приложение на телефоне…' },
      fail: () => { this.status = 'Ожидаем соединение с телефоном…' }
    })
  },
  handleMessage(raw) {
    let message
    try { message = typeof raw === 'string' ? JSON.parse(raw) : raw }
    catch (error) { this.status = 'Не удалось прочитать ответ'; return }
    if (!message || !message.type) return
    if (message.type === 'page_start') {
      this.transferId = message.id || ''
      this.expectedChunks = Number(message.chunks || 0)
      this.chunks = []
      this.received = 0
      this.status = 'ИИ отправляет ответ…'
    } else if (message.type === 'page_chunk') {
      if (message.id !== this.transferId) return
      const index = Number(message.index)
      if (index < 0 || index >= this.expectedChunks) return
      this.chunks[index] = this.base64ToUtf8(message.textBase64 || '')
      this.received++
      this.status = 'Получаем ответ: ' + this.received + '/' + this.expectedChunks
    } else if (message.type === 'page_end') {
      if (message.id !== this.transferId) return
      const answer = this.chunks.join('').trim()
      if (answer) this.conversation = this.conversation + '\n\nИИ:\n' + answer
      this.status = answer ? 'Ответ получен' : 'ИИ вернул пустой ответ'
      this.chunks = []
      this.sendCommand('page_ack', {id: this.transferId, ok: true})
    } else if (message.type === 'transfer_error') {
      this.status = message.message || 'Ошибка передачи ответа'
    }
  },
  base64ToUtf8(base64) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    const len = base64.length
    let size = Math.floor((len * 3) / 4)
    if (base64[len - 1] === '=') size--
    if (base64[len - 2] === '=') size--
    const bytes = new Uint8Array(size)
    let position = 0
    for (let i = 0; i < len; i += 4) {
      const a = chars.indexOf(base64[i]), b = chars.indexOf(base64[i + 1])
      const c = base64[i + 2] === '=' ? 0 : chars.indexOf(base64[i + 2])
      const d = base64[i + 3] === '=' ? 0 : chars.indexOf(base64[i + 3])
      if (position < size) bytes[position++] = (a << 2) | (b >> 4)
      if (position < size) bytes[position++] = ((b & 15) << 4) | (c >> 2)
      if (position < size) bytes[position++] = ((c & 3) << 6) | d
    }
    let encoded = ''
    for (let i = 0; i < bytes.length; i++) encoded += '%' + ('0' + bytes[i].toString(16)).slice(-2)
    try { return decodeURIComponent(encoded) } catch (error) { return '' }
  },
  sendCommand(type, extra) {
    if (!connection) connection = interconnect.instance()
    connection.send({
      data: Object.assign({type: type}, extra || {}),
      success: () => {},
      fail: (error, code) => { this.status = 'Не удалось отправить: ' + String(code || '') }
    })
  },
  makeGlyphs(value) {\n    const output = []\n    const text = String(value || '')\n    for (let i = 0; i < text.length; i++) {\n      const ch = text.charAt(i), code = ch.charCodeAt(0)\n      output.push(code >= 0x0400 && code <= 0x04FF ? {char: ch, image: '/common/glyphs/u' + ('0000' + code.toString(16).toUpperCase()).slice(-4) + '.png'} : {char: ch, image: ''})\n    }\n    return output\n  },\n  updateQueryGlyphs() { this.queryGlyphs = this.makeGlyphs(this.query) },\n  showKeyboard() { this.keyboardVisible = true },
  hideKeyboard() { this.keyboardVisible = false },
  appendKey(key) { this.query = String(this.query || '') + String(key || ''); this.updateQueryGlyphs() },
  deleteKey() { this.query = String(this.query || '').slice(0, -1); this.updateQueryGlyphs() },
  clearInput() { this.query = ''; this.updateQueryGlyphs() },
  toggleKeyboardLanguage() { this.keyboardLanguage = this.keyboardLanguage === 'ru' ? 'en' : 'ru' },
  submitPrompt() {
    const prompt = String(this.query || '').trim()
    if (!prompt) return
    if (prompt.length > 4000) { this.status = 'Вопрос слишком длинный (максимум 4000 символов)'; return }
    this.conversation = this.conversation + '\n\nТы:\n' + prompt
    this.query = ''
    this.keyboardVisible = false
    this.status = 'Отправляем вопрос на телефон…'
    this.sendCommand('ai_prompt', {prompt: prompt})
  }
}
</script>
<style>
.page { width:466px; height:466px; padding:18px 20px 14px; box-sizing:border-box; flex-direction:column; background-color:#101820; align-items:center; }
.brand { color:#ffffff; font-size:30px; font-weight:bold; margin-bottom:4px; }
.status { color:#9eb2c4; font-size:15px; height:24px; }
.chat { width:100%; height:230px; margin-top:8px; margin-bottom:8px; background-color:#182633; border-radius:14px; padding:12px; box-sizing:border-box; }
.conversation { color:#f1f5f9; font-size:19px; line-height:1.35; }
.composer { width:100%; min-height:42px; background-color:#263746; border-radius:12px; padding:10px; box-sizing:border-box; }
.prompt { color:#ffffff; font-size:17px; }
.actions { width:100%; flex-direction:row; justify-content:space-between; margin-top:7px; }
.send { color:#071b26; background-color:#70d6bd; font-size:17px; font-weight:bold; padding:9px 20px; border-radius:12px; }
.clear { color:#d7e1e8; font-size:16px; padding:9px 12px; }
.keyboard { width:100%; margin-top:6px; background-color:#182633; padding:6px; border-radius:12px; }
.keyRow { width:100%; flex-direction:row; justify-content:center; margin-bottom:4px; }
.key { color:#ffffff; background-color:#34495b; font-size:17px; padding:7px 8px; margin:2px; border-radius:7px; }\n.imageKey { width:32px; height:34px; padding:2px; align-items:center; justify-content:center; }\n.glyph { width:26px; height:26px; }\n.typed { width:100%; min-height:32px; flex-direction:row; align-items:center; padding:3px 6px; }\n.typedGlyph { flex-direction:row; align-items:center; }\n.typedImage { width:18px; height:22px; }\n.typedPlain,.typedCursor { color:#ffffff; font-size:18px; }
.special { background-color:#476176; }
.spaceKey { padding-left:28px; padding-right:28px; }
</style>
